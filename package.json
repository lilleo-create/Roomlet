{
  "name": "roomlet",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --experimental-strip-types --experimental-test-isolation=none --test tests/*.test.ts tests/*.test.mjs",
    "test:e2e": "playwright test",
    "demo:dev": "node supabase/demo/runtime.mjs dev",
    "demo:seed": "node supabase/demo/runtime.mjs seed",
    "demo:clean": "node supabase/demo/runtime.mjs clean",
    "demo:build": "node --import ./supabase/demo/build-env.mjs node_modules/next/dist/bin/next build --webpack",
    "predemo:dev": "npm run demo:build"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.6.0",
    "@fontsource-variable/golos-text": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@hono/node-server": "1.19.19",
    "@supabase/lite": "0.11.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.2",
    "embedded-postgres": "17.12.0-beta.19",
    "keen-slider": "6.8.6",
    "lucide-react": "1.82.0",
    "next": "16.4.6",
    "postgres": "3.4.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "~5.9.3"
  }
}
